{
	"$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!.claude",
			"!dist",
			"!node_modules",
			"!**/dist",
			"!**/.astro",
			"!.tmp",
			"!TRASH",
			"!benchmarks",
			"!packages/ts/runners/local-untrusted-js/local-untrusted-js-runner.mjs",
			"!packages/ts/evals/.private/empirical-memory-rerun-avoidance",
			"!packages/ts/evals/.private/graph-native-rerun-avoidance",
			"!packages/ts/evals/graph-native-rerun-avoidance/artifacts",
			"!website",
			"!examples/nestjs",
			"!latency-inputs/P1-inputs.json",
			"!latency-inputs/P3-inputs.json",
			"!latency-inputs/P6-inputs.json",
			"!packages/ts/qualification/causal-occurrence/cold-v1-helper-differential.json",
			"!packages/ts/qualification/causal-occurrence/cold-v1-incoming-differential.json",
			"!packages/ts/qualification/causal-occurrence/cold-v1-standalone-comparison-final.json",
			"!packages/ts/qualification/causal-occurrence/cold-v1-standalone-comparison.json",
			"!packages/ts/qualification/causal-occurrence/ts-v5-inputs.json",
			"!packages/ts/qualification/causal-occurrence/ts-v6-inputs.json",
			"!packages/ts/qualification/causal-occurrence/ts-v7-incoming-differential.json",
			"!packages/ts/qualification/causal-occurrence/ts-v8-cold-inputs.json",
			"!packages/ts/qualification/causal-occurrence/ts-v8-helper-differential.json",
			"!packages/ts/qualification/causal-occurrence/ts-v8-incoming-differential.json",
			"!scripts/causal-global-cold.mjs",
			"!scripts/causal-policy-prototype.mjs",
			"!scripts/check-causal-recording-source.mjs",
			"!scripts/count-causal-policy-comparisons.mjs",
			"!scripts/derive-causal-cpu-driver.mjs",
			"!scripts/derive-causal-recording-driver.mjs"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"overrides": [
		{
			"includes": ["scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noAssignInExpressions": "off"
					},
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useTemplate": "off"
					}
				}
			}
		},
		{
			"includes": ["demos/**"],
			"linter": {
				"rules": {
					"a11y": {
						"noStaticElementInteractions": "off",
						"useButtonType": "off",
						"useKeyWithClickEvents": "off",
						"noLabelWithoutControl": "off",
						"useSemanticElements": "off"
					},
					"correctness": {
						"noUnusedFunctionParameters": "off",
						"noUnusedImports": "off",
						"noUnusedVariables": "off",
						"useHookAtTopLevel": "off",
						"useJsxKeyInIterable": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noAssignInExpressions": "off"
					}
				}
			}
		},
		{
			"includes": ["demos/reactive-layout/src/components/chapters/BlocksChapter.tsx"],
			"linter": {
				"rules": {
					"security": {
						"noDangerouslySetInnerHtml": "off"
					}
				}
			}
		},
		{
			"includes": ["examples/framework/vue/**", "examples/framework/svelte/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["examples/nestjs-graph-boundary/**"],
			"javascript": {
				"parser": {
					"unsafeParameterDecoratorsEnabled": true
				}
			}
		},
		{
			"includes": [
				"scripts/fixtures/causal-preset-numeric-contract-v1.vectors.json",
				"scripts/fixtures/causal-publication-material-v1-vectors.json"
			],
			"formatter": {
				"enabled": false
			}
		}
	]
}
